# Environment Configuration Example (SustainBite / Taiken Ops)

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Google Cloud & Firestore
# Set to "firestore" to use live GCP Firestore, or "local" to use embedded zero-dependency local repository
DATABASE_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=automate-511215
# Path to service account key json if running outside GCP
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Google AI (Gemini)
# Set your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Application Defaults
DEFAULT_RESTAURANT_ID=taiken_kharadi
ALLOWED_USER_EMAILS=
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Frontend Environment (Vite)
# VITE_API_BASE_URL=http://localhost:8000
